# ---------------------------------------------------------------------------
# SÉRENÉ — variáveis de ambiente
# Copie para `.env` e ajuste. O `.env` NUNCA deve ser commitado.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# AMBIENTE
# ---------------------------------------------------------------------------

# development | production. Se vazio: "production" no Vercel (que define a
# variável VERCEL sozinho) e "development" no seu computador.
# Em produção a API se recusa a subir com configuração insegura: exige
# EMAIL_BACKEND=smtp e CORS_ORIGINS preenchido, e desliga o /docs.
APP_ENV=development

# Documentação interativa (/docs, /redoc). Padrão: ligada em development,
# desligada em production.
# ENABLE_DOCS=false

# Nível de log: debug | info | warning | error.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# BANCO
# ---------------------------------------------------------------------------

# String de conexão SQLAlchemy para o MySQL 8+ (driver PyMySQL).
# Formato: mysql+pymysql://USUARIO:SENHA@HOST:PORTA/BANCO?charset=utf8mb4
DATABASE_URL=mysql+pymysql://serene:serene@127.0.0.1:3306/serene?charset=utf8mb4

# TLS na conexão com o banco. Use true em QUALQUER banco hospedado (Aiven,
# TiDB Cloud, PlanetScale, Railway...). O certificado do servidor é sempre
# verificado: por padrão contra as autoridades públicas (certifi).
DATABASE_SSL=false
# Só se o provedor usa uma autoridade própria (ex.: Aiven): caminho do
# arquivo .pem que ele fornece, relativo à pasta backend.
# DATABASE_SSL_CA=certs/ca.pem

# ---------------------------------------------------------------------------
# AUTENTICAÇÃO (JWT)
# ---------------------------------------------------------------------------

# Chave usada para assinar os JWT. Gere uma aleatória e longa, ex.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Trocar essa chave invalida todos os tokens já emitidos. A API se recusa a
# subir com o valor de exemplo abaixo (qualquer pessoa poderia forjar tokens).
JWT_SECRET_KEY=troque-esta-chave-por-uma-aleatoria-e-longa

# Algoritmo de assinatura do JWT: HS256 | HS384 | HS512 (outros são recusados).
JWT_ALGORITHM=HS256

# Validade do access token, em minutos.
JWT_EXPIRE_MINUTES=60

# Origens liberadas no CORS (separadas por vírgula, sem barra no final).
# Em produção: a URL do frontend, ex.: https://serene.vercel.app
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------------
# EMAIL — envio do código de verificação de 4 dígitos no cadastro
# ---------------------------------------------------------------------------

# Como enviar os emails:
#   smtp    → envio real, usando as variáveis SMTP_* abaixo (use em produção).
#   console → só imprime o email (e o código) no terminal do uvicorn. Bom para
#             desenvolver antes de configurar um email. NUNCA use em produção.
EMAIL_BACKEND=smtp

# Servidor SMTP. Exemplos:
#   Gmail:   SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  SMTP_SECURITY=starttls
#   Outlook: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURITY=starttls
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Criptografia da conexão:
#   starttls → porta 587 (o mais comum)
#   ssl      → porta 465
#   nenhuma  → só para servidores de teste locais (ex.: Mailpit na porta 1025)
SMTP_SECURITY=starttls

# Login da conta que vai ENVIAR os emails.
# Gmail: SMTP_PASSWORD NÃO é a senha normal da conta — é uma "senha de app"
# de 16 letras, gerada em https://myaccount.google.com/apppasswords
# (exige verificação em duas etapas ativada na conta Google).
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-app

# Endereço que aparece como remetente. Se vazio, usa SMTP_USER. No Gmail e no
# Outlook ele precisa ser a própria conta do SMTP_USER.
SMTP_FROM=

# ---------------------------------------------------------------------------
# Código de verificação (opcionais — os valores abaixo são os padrões)
# ---------------------------------------------------------------------------

# Validade do código, em minutos.
EMAIL_CODE_EXPIRE_MINUTES=10
# Tentativas erradas permitidas por código (depois disso, só pedindo outro).
EMAIL_CODE_MAX_ATTEMPTS=5
# Intervalo mínimo, em segundos, entre um envio e o próximo pedido de reenvio.
EMAIL_CODE_RESEND_SECONDS=60
# Máximo de códigos enviados para a mesma conta por hora.
EMAIL_CODE_MAX_SENDS_PER_HOUR=5

# ---------------------------------------------------------------------------
# FOTO DE PERFIL — Cloudinary (opcional)
# ---------------------------------------------------------------------------
# Onde as fotos de perfil ficam hospedadas. Sem estas três variáveis a API
# sobe normalmente e só o envio de foto responde "ainda não configurado".
# Preencher só parte delas impede a API de iniciar (erro de cópia).
#
# Onde achar: cloudinary.com → entre na conta → Dashboard (ou Settings →
# API Keys). "Cloud name", "API Key" e "API Secret".
# O API Secret é uma senha: nunca no frontend, nunca no Git.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Pasta dentro do Cloudinary onde as fotos são guardadas.
CLOUDINARY_FOLDER=serene/perfis

# ---------------------------------------------------------------------------
# PROTEÇÕES
# ---------------------------------------------------------------------------

# Limite de tentativas por IP/email em login, cadastro e confirmação.
# Desligue só para depurar localmente.
RATE_LIMIT_ENABLED=true

# Ler o IP real da cliente dos headers X-Forwarded-For. Padrão: true no
# Vercel (que sobrescreve o header, não dá para falsificar) e false fora
# dele. NÃO ligue atrás de um proxy que repasse o header da cliente.
# TRUST_PROXY_HEADERS=false

# (Opcional, só para testes) Banco usado pelo pytest. Se ausente, os testes
# rodam em SQLite em memória. Aponte para um banco MySQL DESCARTÁVEL — as
# tabelas são criadas e apagadas a cada teste.
# TEST_DATABASE_URL=mysql+pymysql://serene:serene@127.0.0.1:3306/serene_test?charset=utf8mb4
